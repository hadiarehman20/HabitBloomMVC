@{
    ViewData["Title"] = "Home";
}

<!-- HERO SECTION -->
<section class="hero-section">

    <div class="container-fluid px-lg-0">

        <div class="row align-items-center g-0">

            <!-- HERO TEXT -->
            <div class="col-lg-5 hero-content">

                <p class="hero-tag">
                    <span>✿</span> A FRESH START EVERY DAY
                </p>

                <h1 class="hero-heading">
                    Grow Better Habits,
                    <span>One Day at a Time.</span>
                </h1>

                <p class="hero-description">
                    You don't have to change everything in one day.
                    Start with one small habit, stay consistent,
                    and let the little things make a difference.
                </p>

                <div class="hero-buttons">

                    <a asp-area="Identity"
                       asp-page="/Account/Register"
                       class="btn btn-maroon">
                        Get Started <span>→</span>
                    </a>

                    <a asp-area="Identity"
                       asp-page="/Account/Login"
                       class="btn btn-outline-green">
                        Login
                    </a>

                </div>

                <p class="handwritten-note">
                    Little by little ♡
                </p>

            </div>

            <!-- HERO IMAGE -->
            <div class="col-lg-7 hero-visual">

                <img src="~/images/hero-flowers.png"
                     alt="Pink flowers, books and a floral cup"
                     class="hero-image">

            </div>

        </div>

    </div>

</section>


<!-- QUOTATION SECTION -->
<section class="quote-section">

    <div class="container">

        <div class="quote-box">

            <span class="quote-symbol">“</span>

            <div class="quote-content">

                <p class="quote-text">
                    Small, consistent actions create
                    the biggest changes.
                </p>

                <span class="quote-line"></span>

            </div>

            <span class="quote-flower">❀</span>

        </div>

    </div>

</section>


<!-- FEATURES SECTION -->
<section class="features-section" id="features">

    <div class="container">

        <div class="section-heading text-center">

            <p class="section-tag">
                ✿ WHAT YOU CAN DO ✿
            </p>

            <h2>
                Make Every Day <span>Count</span>
            </h2>

            <p class="section-description">
                Everything you need to build a better daily routine.
            </p>

        </div>


        <div class="row g-4 mt-3">

            <!-- FEATURE 1 -->
            <div class="col-md-4">

                <div class="feature-card habit-card">

                    <div class="feature-icon">
                        <span>✓</span>
                    </div>

                    <div class="feature-content">

                        <h4>Build Habits</h4>

                        <p>
                            Create meaningful daily habits
                            and develop positive routines.
                        </p>

                    </div>

                    <span class="card-decoration">❀</span>

                </div>

            </div>


            <!-- FEATURE 2 -->
            <div class="col-md-4">

                <div class="feature-card progress-card">

                    <div class="feature-icon">
                        <span>↗</span>
                    </div>

                    <div class="feature-content">

                        <h4>Track Progress</h4>

                        <p>
                            Monitor your daily achievements
                            and celebrate your progress.
                        </p>

                    </div>

                    <span class="card-decoration">✿</span>

                </div>

            </div>


            <!-- FEATURE 3 -->
            <div class="col-md-4">

                <div class="feature-card friends-card">

                    <div class="feature-icon">
                        <span>♡</span>
                    </div>

                    <div class="feature-content">

                        <h4>Grow Together</h4>

                        <p>
                            Join challenges with friends
                            and motivate each other.
                        </p>

                    </div>

                    <span class="card-decoration">❀</span>

                </div>

            </div>

        </div>

    </div>

</section>
