@model HabitBloomMVC.Models.Habit

@{
    ViewData["Title"] = "Edit Habit";
}

<style>
    .edit-page {
        min-height: 100vh;
        background: #fffaf7;
        padding: 40px 20px;
        font-family: 'Segoe UI', sans-serif;
    }

    .edit-card {
        max-width: 650px;
        margin: auto;
        background: white;
        padding: 35px;
        border-radius: 22px;
        border: 1px solid #f0e1e7;
        box-shadow: 0 8px 25px rgba(100, 50, 70, 0.06);
    }

        .edit-card h1 {
            color: #6d3c50;
            margin-bottom: 10px;
            font-size: 30px;
        }

    .subtitle {
        color: #8d7180;
        margin-bottom: 30px;
    }

    .form-group {
        margin-bottom: 22px;
    }

        .form-group label {
            display: block;
            color: #6d3c50;
            font-weight: 600;
            margin-bottom: 8px;
        }

    .form-control {
        width: 100%;
        padding: 12px;
        border: 1px solid #e5ccd7;
        border-radius: 10px;
        font-size: 15px;
        box-sizing: border-box;
        background: white;
    }

        .form-control:focus {
            outline: none;
            border-color: #98647c;
            box-shadow: 0 0 0 3px rgba(152, 100, 124, 0.12);
        }

    textarea.form-control {
        resize: vertical;
    }

    .validation {
        color: #c04460;
        font-size: 13px;
    }

    .buttons {
        display: flex;
        gap: 12px;
        margin-top: 30px;
        flex-wrap: wrap;
    }

    .save-btn {
        background: #7b455c;
        color: white;
        border: none;
        padding: 12px 22px;
        border-radius: 10px;
        font-weight: 600;
        cursor: pointer;
        transition: 0.2s;
    }

        .save-btn:hover {
            background: #633449;
        }

    .cancel-btn {
        background: #f5e9ef;
        color: #7b455c;
        padding: 12px 22px;
        border-radius: 10px;
        text-decoration: none;
        font-weight: 600;
        transition: 0.2s;
    }

        .cancel-btn:hover {
            background: #ead7e1;
        }

    .edit-note {
        margin-top: 25px;
        padding: 15px;
        border-radius: 12px;
        background: #faf2f6;
        color: #87556b;
        font-size: 14px;
        line-height: 1.6;
    }
</style>

<div class="edit-page">
    <div class="edit-card">

        <h1>Edit Your Habit 🌷</h1>

        <p class="subtitle">
            You can adjust your goals as you grow.
        </p>

        <form asp-controller="Habit"
              asp-action="Edit"
              asp-route-id="@Model.HabitId"
              method="post">

            @Html.AntiForgeryToken()

            <input type="hidden" name="id" value="@Model.HabitId" />

            <div asp-validation-summary="ModelOnly" class="validation"></div>

            <!-- Habit Name -->
            <div class="form-group">
                <label for="name">Habit Name</label>

                <input type="text"
                       id="name"
                       name="name"
                       value="@Model.Name"
                       class="form-control"
                       maxlength="100"
                       required />

                <span asp-validation-for="Name" class="validation"></span>
            </div>

            <!-- Category -->
            <div class="form-group">
                <label for="category">Category</label>

                <select id="category"
                        name="category"
                        class="form-control"
                        required>

                    <option value="">Select a category</option>

                    <option value="Health" selected="@(Model.Category == "Health")">Health</option>
                    <option value="Fitness" selected="@(Model.Category == "Fitness")">Fitness</option>
                    <option value="Study" selected="@(Model.Category == "Study")">Study</option>
                    <option value="Mindfulness" selected="@(Model.Category == "Mindfulness")">Mindfulness</option>
                    <option value="Personal Growth" selected="@(Model.Category == "Personal Growth")">Personal Growth</option>
                    <option value="Productivity" selected="@(Model.Category == "Productivity")">Productivity</option>
                    <option value="Lifestyle" selected="@(Model.Category == "Lifestyle")">Lifestyle</option>
                    <option value="Other" selected="@(Model.Category == "Other")">Other</option>

                </select>

                <span asp-validation-for="Category" class="validation"></span>
            </div>

            <!-- Description -->
            <div class="form-group">
                <label for="description">Description (Optional)</label>

                <textarea id="description"
                          name="description"
                          class="form-control"
                          rows="4"
                          maxlength="300"
                          placeholder="Why is this habit important to you?">@Model.Description</textarea>

                <span asp-validation-for="Description" class="validation"></span>
            </div>

            <!-- Buttons -->
            <div class="buttons">

                <button type="submit" class="save-btn">
                    Save Changes
                </button>

                <a asp-controller="Habit"
                   asp-action="Index"
                   class="cancel-btn">
                    Cancel
                </a>

            </div>

        </form>

        <div class="edit-note">
            🌱 Growth isn't about being perfect. It's about adjusting,
            learning, and continuing forward.
        </div>

    </div>
</div>
