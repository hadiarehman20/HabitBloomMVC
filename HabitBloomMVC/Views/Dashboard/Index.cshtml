@model IEnumerable<HabitBloomMVC.Models.Habit>

@{
    ViewData["Title"] = "HabitBloom | Dashboard";
    Layout = null;

    var completedHabitIds = ViewBag.CompletedHabitIds as List<int> ?? new List<int>();
    int totalHabits = ViewBag.TotalHabits ?? 0;
    int completedToday = ViewBag.CompletedToday ?? 0;
    int currentStreak = ViewBag.CurrentStreak ?? 0;

    var habitProgress = totalHabits > 0
        ? (int)Math.Round((double)completedToday / totalHabits * 100)
        : 0;

    var weeklyProgress = ViewBag.WeeklyProgress as List<int>
                         ?? new List<int> { 0, 0, 0, 0, 0, 0, 0 };

    var weekDays = new[] { "Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun" };
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HabitBloom | Dashboard</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.css" />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;600;700&family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />

    <style>
        .hb-calendar-grid button.has-completion {
            border: 2px solid #8b4a61;
            position: relative;
        }

            .hb-calendar-grid button.has-completion::after {
                content: "";
                position: absolute;
                bottom: 3px;
                width: 5px;
                height: 5px;
                border-radius: 50%;
                background-color: #8b4a61;
            }
    </style>
</head>

<body class="hb-dashboard">

    <div class="hb-layout">

        <!-- SIDEBAR -->
        <aside class="hb-sidebar">

            <a asp-controller="Home" asp-action="Index" class="hb-logo">
                <span>❀</span> HabitBloom
            </a>

            <p class="hb-menu-label">MENU</p>

            <nav class="hb-navigation">

                <a asp-controller="Dashboard" asp-action="Index" class="active">
                    <span>⌂</span> Dashboard
                </a>

                <a asp-controller="Habit" asp-action="Index">
                    <span>✿</span> My Habits
                </a>

                <a href="#progress">
                    <span>▥</span> Progress
                </a>

                <a href="#calendar">
                    <span>▦</span> Calendar
                </a>

                <a href="#wellness">
                    <span>♡</span> Wellness
                </a>

            </nav>

            <div class="hb-sidebar-bottom">

                <div class="hb-sidebar-note">
                    <span>🌷</span>
                    <p>Bloom at your own pace. Every little effort counts.</p>
                </div>

                <form asp-area="Identity"
                      asp-page="/Account/Logout"
                      asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })"
                      method="post"
                      class="hb-logout-form">

                    <button type="submit" class="hb-logout">
                        ↪ &nbsp; Logout
                    </button>

                </form>

            </div>

        </aside>


        <!-- MAIN CONTENT -->
        <main class="hb-main">

            <!-- TOP BAR -->
            <header class="hb-topbar">

                <div>
                    <p class="hb-date-label">YOUR PERSONAL SPACE</p>
                    <h2>Dashboard</h2>
                </div>

                <div class="hb-profile">

                    <div class="hb-profile-flower">✿</div>

                    <div>
                        <strong>@(User.Identity?.Name ?? "Bloom User")</strong>
                        <small>HabitBloom Member</small>
                    </div>

                </div>

            </header>


            <!-- WELCOME SECTION -->
            <section class="hb-welcome">

                <div>
                    <p class="hb-eyebrow">A FRESH START, A NEW DAY</p>
                    <h1>Good Morning, Bloom! <span>🌷</span></h1>
                    <p>Small steps today, beautiful changes tomorrow.</p>
                </div>

                <div class="hb-welcome-decoration">
                    <span>✿</span>
                    <p>GROW THROUGH<br>WHAT YOU GO THROUGH</p>
                </div>

            </section>


            <!-- QUOTE -->
            <section class="hb-quote">
                <span>“</span>
                <p>Trust the timing of your bloom. Keep growing, one habit at a time.</p>
                <span>❀</span>
            </section>


            <!-- OVERVIEW CARDS -->
            <section class="hb-overview">

                <div class="hb-overview-card">

                    <div class="hb-overview-icon sage-icon">🌱</div>

                    <div>
                        <small>TOTAL HABITS</small>
                        <h3>@totalHabits.ToString("00")</h3>
                        <p>Your daily routines</p>
                    </div>

                </div>


                <div class="hb-overview-card">

                    <div class="hb-overview-icon pink-icon">🌸</div>

                    <div>
                        <small>COMPLETED TODAY</small>
                        <h3 id="completedNumber">@completedToday.ToString("00")</h3>

                        <p>
                            @(totalHabits > 0 && completedToday == totalHabits
                                                        ? "All goals achieved!"
                                                        : "Keep going!")
                        </p>
                    </div>

                </div>


                <div class="hb-overview-card">

                    <div class="hb-overview-icon maroon-icon">🔥</div>

                    <div>
                        <small>CURRENT STREAK</small>
                        <h3>@currentStreak</h3>

                        <p>
                            @(currentStreak == 1 ? "Day in a row" : "Days in a row")
                        </p>
                    </div>

                </div>

            </section>


            <!-- MAIN DASHBOARD GRID -->
            <section class="hb-main-grid">


                <!-- DAILY BALANCE -->
                <div class="hb-panel hb-balance">

                    <div class="hb-panel-heading">

                        <div>
                            <h3>Daily Balance</h3>
                            <p>Your overall wellness</p>
                        </div>

                        <span class="hb-tag">Today</span>

                    </div>

                    <div class="hb-balance-circle">

                        <div class="hb-balance-inner">
                            <span>@habitProgress%</span>
                            <small>COMPLETED</small>
                        </div>

                    </div>

                    <div class="hb-balance-legend">
                        <span><i class="legend-mind"></i> Mind</span>
                        <span><i class="legend-body"></i> Body</span>
                        <span><i class="legend-energy"></i> Energy</span>
                    </div>

                </div>


                <!-- TODAY'S GOALS -->
                <div class="hb-panel hb-goals" id="habits">

                    <div class="hb-panel-heading">

                        <div>
                            <h3>Today's Goals</h3>
                            <p>Make today count</p>
                        </div>

                        <a asp-controller="Habit"
                           asp-action="Create"
                           class="hb-flower-icon"
                           title="Add a new habit">
                            ✿
                        </a>

                    </div>


                    <div class="hb-habit-progress">

                        <div class="hb-habit-progress-track">
                            <div style="width: @(habitProgress)%"></div>
                        </div>

                        <small>
                            @completedToday of @totalHabits completed
                        </small>

                    </div>


                    <div class="hb-goal-list">

                        @if (Model != null && Model.Any())
                        {
                            foreach (var habit in Model)
                            {
                                bool isCompleted = completedHabitIds.Contains(habit.HabitId);

                                <div class="hb-goal-item">

                                    <span class="hb-custom-check">
                                        @(isCompleted ? "✓" : "")
                                    </span>

                                    <span style="@(isCompleted ? "text-decoration: line-through;" : "")">
                                        @habit.Name
                                    </span>

                                    @if (isCompleted)
                                    {
                                        <form asp-controller="Dashboard"
                                              asp-action="UndoComplete"
                                              method="post"
                                              style="margin-left:auto;">

                                            <input type="hidden" name="id" value="@habit.HabitId" />

                                            <button type="submit" class="btn btn-sm btn-outline-secondary">
                                                Undo
                                            </button>

                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-controller="Dashboard"
                                              asp-action="Complete"
                                              method="post"
                                              style="margin-left:auto;">

                                            <input type="hidden" name="id" value="@habit.HabitId" />

                                            <button type="submit" class="btn btn-sm btn-outline-success">
                                                Complete
                                            </button>

                                        </form>
                                    }

                                </div>
                            }
                        }
                        else
                        {
                            <p>You haven't added any habits yet.</p>

                            <a asp-controller="Habit" asp-action="Create">
                                Add your first habit
                            </a>
                        }

                    </div>

                    <p class="hb-goal-footer">
                        Every completed habit is a little victory! ♡
                    </p>

                </div>


                <!-- CALENDAR -->
                <div class="hb-panel hb-calendar" id="calendar">

                    <div class="hb-panel-heading">

                        <div>
                            <h3>Calendar</h3>
                            <p>Your monthly overview</p>
                        </div>

                        <span>▦</span>

                    </div>


                    <div class="hb-calendar-month">

                        <button type="button" id="prevMonth">‹</button>

                        <strong id="calendarMonth"></strong>

                        <button type="button" id="nextMonth">›</button>

                    </div>


                    <div class="hb-calendar-grid" id="calendarGrid">

                        <span>Su</span>
                        <span>Mo</span>
                        <span>Tu</span>
                        <span>We</span>
                        <span>Th</span>
                        <span>Fr</span>
                        <span>Sa</span>

                    </div>

                    <p class="hb-calendar-note">
                        ✿ A new day is a new opportunity.
                    </p>

                </div>

            </section>


            <!-- WELLNESS CARDS -->
            <section class="hb-wellness-section" id="wellness">

                <div class="hb-section-title">

                    <div>
                        <h2>Your Wellness Corner</h2>
                        <p>Take care of yourself, inside and out.</p>
                    </div>

                    <span>♡</span>

                </div>


                <div class="hb-wellness-grid">


                    <!-- ACTIVITY -->
                    <div class="hb-panel hb-wellness-card">

                        <div class="hb-wellness-heading">
                            <span>👟</span>
                            <small>DAILY ACTIVITY</small>
                        </div>

                        <h3>5,240 <small>steps</small></h3>

                        <div class="hb-activity-track">
                            <span></span>
                        </div>

                        <p>You're making progress. Keep moving!</p>

                    </div>


                    <!-- WATER -->
                    <div class="hb-panel hb-wellness-card">

                        <div class="hb-wellness-heading">
                            <span>💧</span>
                            <small>WATER INTAKE</small>
                        </div>

                        <h3 id="waterCount">5 / 8 <small>glasses</small></h3>

                        <div class="hb-water-controls">

                            <button type="button" id="waterMinus">−</button>

                            <div class="hb-water-track">
                                <span id="waterProgress"></span>
                            </div>

                            <button type="button" id="waterPlus">+</button>

                        </div>

                        <p id="waterMessage">
                            Stay hydrated throughout the day.
                        </p>

                    </div>


                    <!-- MEDITATION -->
                    <div class="hb-panel hb-wellness-card hb-meditation-card">

                        <div class="hb-wellness-heading">
                            <span>🧘</span>
                            <small>MINDFUL MOMENT</small>
                        </div>

                        <h3>Find your calm.</h3>

                        <p>
                            Take a little time to breathe and reset your mind.
                        </p>

                        <span class="hb-meditation-flower">✿</span>

                    </div>


                    <!-- SLEEP -->
                    <div class="hb-panel hb-wellness-card">

                        <div class="hb-wellness-heading">
                            <span>🌙</span>
                            <small>SLEEP QUALITY</small>
                        </div>

                        <h3>7h 20m <small>rest</small></h3>

                        <div class="hb-sleep-track">
                            <span></span>
                        </div>

                        <p>A good night's rest helps you bloom.</p>

                    </div>

                </div>

            </section>


            <!-- WEEKLY PROGRESS -->
            <section class="hb-panel hb-weekly" id="progress">

                <div class="hb-section-title">

                    <div>
                        <h2>Weekly Progress</h2>
                        <p>Celebrate how far you've come.</p>
                    </div>

                    <span class="hb-tag">This Week</span>

                </div>


                <div class="hb-chart">

                    @for (int i = 0; i < 7; i++)
                    {
                        int percentage = i < weeklyProgress.Count
                        ? weeklyProgress[i]
                        : 0;

                        <div class="hb-chart-column">

                            <div class="hb-chart-bar"
                                 style="height: @(percentage)%">
                            </div>

                            <small>@weekDays[i]</small>
                            <small>@percentage%</small>

                        </div>
                    }

                </div>

            </section>


            <!-- FOOTER -->
            <footer class="hb-footer">
                ❀ HabitBloom — Small steps. Beautiful growth.
            </footer>

        </main>

    </div>


    <!-- JAVASCRIPT -->
    <script>

        // WATER TRACKER

        let glasses = 5;

        function updateWater() {

            document.getElementById("waterCount").innerHTML =
                glasses + " / 8 <small>glasses</small>";

            document.getElementById("waterProgress").style.width =
                (glasses / 8 * 100) + "%";

            document.getElementById("waterMessage").textContent =
                glasses === 8
                    ? "Daily water goal achieved! 🌸"
                    : "Stay hydrated throughout the day.";

        }


        document.getElementById("waterPlus").addEventListener("click", function () {

            if (glasses < 8) {
                glasses++;
                updateWater();
            }

        });


        document.getElementById("waterMinus").addEventListener("click", function () {

            if (glasses > 0) {
                glasses--;
                updateWater();
            }

        });


        updateWater();


        // CALENDAR

        const completedDates = @Html.Raw(
                        System.Text.Json.JsonSerializer.Serialize(
                                ViewBag.CompletedDates ?? new List<string>()
                        )
                );

        const calendarGrid = document.getElementById("calendarGrid");
        const calendarMonth = document.getElementById("calendarMonth");

        const today = new Date();

        let displayedMonth = today.getMonth();
        let displayedYear = today.getFullYear();


        function renderCalendar() {

            const monthNames = [
                "January", "February", "March", "April",
                "May", "June", "July", "August",
                "September", "October", "November", "December"
            ];

            calendarMonth.textContent =
                monthNames[displayedMonth] + " " + displayedYear;


            calendarGrid.innerHTML = `
                <span>Su</span>
                <span>Mo</span>
                <span>Tu</span>
                <span>We</span>
                <span>Th</span>
                <span>Fr</span>
                <span>Sa</span>
            `;


            const firstDay =
                new Date(displayedYear, displayedMonth, 1).getDay();

            const daysInMonth =
                new Date(displayedYear, displayedMonth + 1, 0).getDate();


            for (let i = 0; i < firstDay; i++) {

                const blank = document.createElement("span");
                calendarGrid.appendChild(blank);

            }


            for (let day = 1; day <= daysInMonth; day++) {

                const dateButton = document.createElement("button");

                dateButton.type = "button";
                dateButton.textContent = day;


                const dateKey =
                    displayedYear + "-" +
                    String(displayedMonth + 1).padStart(2, "0") + "-" +
                    String(day).padStart(2, "0");


                // Mark dates with completed habits
                if (completedDates.includes(dateKey)) {
                    dateButton.classList.add("has-completion");
                }


                // Highlight today's date
                if (
                    day === today.getDate() &&
                    displayedMonth === today.getMonth() &&
                    displayedYear === today.getFullYear()
                ) {
                    dateButton.classList.add("selected-day");
                }


                // Select a calendar date
                dateButton.addEventListener("click", function () {

                    calendarGrid.querySelectorAll("button").forEach(function (button) {
                        button.classList.remove("selected-day");
                    });

                    dateButton.classList.add("selected-day");

                });


                calendarGrid.appendChild(dateButton);

            }

        }


        // Previous month
        document.getElementById("prevMonth").addEventListener("click", function () {

            displayedMonth--;

            if (displayedMonth < 0) {
                displayedMonth = 11;
                displayedYear--;
            }

            renderCalendar();

        });


        // Next month
        document.getElementById("nextMonth").addEventListener("click", function () {

            displayedMonth++;

            if (displayedMonth > 11) {
                displayedMonth = 0;
                displayedYear++;
            }

            renderCalendar();

        });


        renderCalendar();

    </script>

</body>
</html>
