@page
@model RegisterConfirmationModel

@{
    ViewData["Title"] = "Registration Complete";
}

<style>
    .confirmation-page {
        min-height: 75vh;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 65px 20px;
        background: radial-gradient(circle at 10% 15%, #f4e4df 0, transparent 25%), radial-gradient(circle at 90% 85%, #eadbd5 0, transparent 28%), #fffaf5;
        font-family: 'Poppins', sans-serif;
    }

    .confirmation-card {
        width: 100%;
        max-width: 650px;
        text-align: center;
        background: #ffffff;
        padding: 55px 45px;
        border-radius: 24px;
        border: 1px solid #f0e1d9;
        box-shadow: 0 15px 45px rgba(92, 45, 52, 0.10);
        position: relative;
        overflow: hidden;
    }

        .confirmation-card::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 6px;
            background: linear-gradient(90deg, #8b3a50, #c58b91, #8b3a50);
        }

    .confirmation-icon {
        width: 90px;
        height: 90px;
        margin: 0 auto 25px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: #f8eceb;
        color: #87394e;
        font-size: 48px;
        box-shadow: 0 5px 18px rgba(135, 57, 78, 0.10);
    }

    .confirmation-tag {
        color: #9b6470;
        font-size: 12px;
        font-weight: 600;
        letter-spacing: 3px;
        margin-bottom: 15px;
    }

    .confirmation-card h1 {
        color: #393b32;
        font-family: Georgia, serif;
        font-size: clamp(34px, 5vw, 48px);
        font-weight: 500;
        margin-bottom: 20px;
    }

        .confirmation-card h1 span {
            color: #87394e;
            font-style: italic;
        }

    .confirmation-message {
        color: #77736e;
        font-size: 15px;
        line-height: 1.9;
        max-width: 490px;
        margin: 0 auto 28px;
    }

    .confirmation-note {
        color: #87394e;
        background: #fbf1f0;
        padding: 13px;
        border-radius: 10px;
        font-size: 14px;
        margin-bottom: 20px;
    }

    .confirmation-button {
        display: inline-block;
        background: #87394e;
        color: white !important;
        text-decoration: none !important;
        padding: 14px 32px;
        border-radius: 30px;
        font-size: 14px;
        font-weight: 500;
        margin-bottom: 18px;
        transition: all 0.3s ease;
    }

        .confirmation-button:hover {
            background: #692a3c;
            transform: translateY(-2px);
            box-shadow: 0 7px 18px rgba(135, 57, 78, 0.2);
        }

    .confirmation-login {
        display: inline-block;
        background: #87394e;
        color: white !important;
        text-decoration: none !important;
        padding: 14px 38px;
        border-radius: 30px;
        font-size: 14px;
        font-weight: 500;
        margin: 5px 0 22px;
        transition: all 0.3s ease;
    }

        .confirmation-login:hover {
            background: #692a3c;
            transform: translateY(-2px);
            box-shadow: 0 7px 18px rgba(135, 57, 78, 0.2);
        }

    .confirmation-home {
        display: block;
        color: #87394e;
        text-decoration: none;
        font-size: 14px;
        margin-top: 5px;
    }

        .confirmation-home:hover {
            color: #542333;
            text-decoration: underline;
        }

    .confirmation-decoration {
        color: #d8b4b5;
        font-size: 22px;
        margin-top: 25px;
        letter-spacing: 10px;
    }

    @@media (max-width: 576px) {
        .confirmation-card {
            padding: 45px 22px;
        }

        .confirmation-message {
            font-size: 14px;
        }
    }
</style>

<div class="confirmation-page">
    <div class="confirmation-card">

        <div class="confirmation-icon">✿</div>

        <p class="confirmation-tag">WELCOME TO HABITBLOOM</p>

        <h1>Your Journey <span>Begins!</span></h1>

        <p class="confirmation-message">
            Your account has been created successfully.
            You're one step closer to building beautiful habits
            and becoming your best self.
        </p>

        @if (Model.DisplayConfirmAccountLink)
        {
            <p class="confirmation-note">
                Please confirm your account using the link below.
            </p>

            <a id="confirm-link"
               href="@Model.EmailConfirmationUrl"
               class="confirmation-button">
                Confirm My Account
            </a>
        }

        <a asp-area="Identity"
           asp-page="/Account/Login"
           class="confirmation-login">
            Continue to Login
        </a>

        <a asp-controller="Home"
           asp-action="Index"
           class="confirmation-home">
            ← Back to Home
        </a>

        <div class="confirmation-decoration">
            ✿ ❀ ✿
        </div>

    </div>
</div>
